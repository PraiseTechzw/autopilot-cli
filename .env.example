# Autopilot environment template
# Copy this file to .env and fill in the values you need for your local setup.
# Secrets should not be committed to version control.

# Global runtime configuration
AUTOPILOT_CONFIG_DIR=

# AI provider configuration
# Get OPENROUTER_API_KEY from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_API_KEY=
AUTOPILOT_AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AUTOPILOT_AI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AUTOPILOT_AI_MODEL=openrouter/free
AI_APP_TITLE=Autopilot
AUTOPILOT_AI_APP_TITLE=Autopilot
AI_HTTP_REFERER=
AUTOPILOT_AI_HTTP_REFERER=
AI_TIMEOUT=45
AUTOPILOT_AI_TIMEOUT=45

# GitHub configuration
# Get GITHUB_TOKEN from: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=
GH_TOKEN=
AUTOPILOT_GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
AUTOPILOT_GITHUB_API_URL=https://api.github.com

# Autopilot config overrides
AUTOPILOT_DEFAULT_BASE=main
AUTOPILOT_DEFAULT_BASE_BRANCH=main
AUTOPILOT_COMMAND_TIMEOUT=120
AUTOPILOT_COMMAND_TIMEOUT_SECONDS=120
AUTOPILOT_WATCH_INTERVAL=5
AUTOPILOT_WATCH_INTERVAL_SECONDS=5
