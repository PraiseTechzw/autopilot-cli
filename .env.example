# Optional AI commit-message generation. Create an API key at OpenRouter,
# then copy this file to .env.local and set the value locally. Never commit .env.local.
OPENROUTER_API_KEY=

# Local web bridge defaults
AUTOPILOT_API_URL=http://localhost:5000
AUTOPILOT_WEB_URL=http://localhost:3000

# Supabase Realtime telemetry and optional leaderboard storage.
# Use a service-role key only in this local CLI process; never expose it in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=   # supported when RLS permits the required reads
SUPABASE_KEY=           # supported alias for an anon/project API key

# GitHub OAuth App (required only for the Web Tool's “Connect GitHub” button)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/github/callback
GITHUB_OAUTH_STATE_SECRET=
SESSION_ENCRYPTION_KEY=
