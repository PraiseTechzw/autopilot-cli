# Local development environment for Autopilot.
# Keep this file private; do not commit real secrets.
# Each developer should set their own values locally.

# Optional: custom config directory for user config
AUTOPILOT_CONFIG_DIR=

# AI provider: OpenRouter is the default.
# Get this from: https://openrouter.ai/keys
OPENROUTER_API_KEY=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

AI_API_KEY=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

AUTOPILOT_AI_API_KEY=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


# OpenAI-compatible provider config
# AI_BASE_URL: default OpenRouter endpoint or your own compatible gateway
AI_BASE_URL=https://openrouter.ai/api/v1
AUTOPILOT_AI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# AI_MODEL: choose a model, for example openrouter/free or a provider-specific model
AI_MODEL=openrouter/free
AUTOPILOT_AI_MODEL=openrouter/free

# Optional AI metadata
AI_APP_TITLE=Autopilot
AUTOPILOT_AI_APP_TITLE=Autopilot
AI_HTTP_REFERER=
AUTOPILOT_AI_HTTP_REFERER=
AI_TIMEOUT=45
AUTOPILOT_AI_TIMEOUT=45

# GitHub token for GitHub API calls.
# Get this from: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=
GH_TOKEN=
AUTOPILOT_GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
AUTOPILOT_GITHUB_API_URL=https://api.github.com

# Project defaults / runtime tuning
AUTOPILOT_DEFAULT_BASE=main
AUTOPILOT_DEFAULT_BASE_BRANCH=main
AUTOPILOT_COMMAND_TIMEOUT=120
AUTOPILOT_COMMAND_TIMEOUT_SECONDS=120
AUTOPILOT_WATCH_INTERVAL=5
AUTOPILOT_WATCH_INTERVAL_SECONDS=5
